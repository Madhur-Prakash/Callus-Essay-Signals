# Copy to `backend/.env` and edit. Never commit `.env`.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env

# ----------------------------------------------------------------- application
APP_ENV = "YOUR_APP_ENV"
LOG_LEVEL = "YOUR_LOG_LEVEL"
LOG_DIR = "YOUR_LOG_DIR"
# true emits JSON log lines instead of coloured console output (for aggregators)
LOG_JSON = "YOUR_LOG_JSON"
# include per-stage timings in the analysis response
DEBUG_TIMINGS = "YOUR_DEBUG_TIMINGS"

# -------------------------------------------------------------------- security
# Comma-separated list of allowed browser origins.
CORS_ORIGINS = "YOUR_CORS_ORIGINS"
MAX_ESSAY_CHARS = "YOUR_MAX_ESSAY_CHARS"
MIN_ESSAY_CHARS = "YOUR_MIN_ESSAY_CHARS"
MAX_REQUEST_BYTES = "YOUR_MAX_REQUEST_BYTES"
RATE_LIMIT_ENABLED = "YOUR_RATE_LIMIT_ENABLED"
RATE_LIMIT_REQUESTS = "YOUR_RATE_LIMIT_REQUESTS"
RATE_LIMIT_WINDOW_SECONDS = "YOUR_RATE_LIMIT_WINDOW_SECONDS"

# --------------------------------------------------------------------- privacy
# When false, the essay body is NEVER written to storage. Only metadata,
# derived measurements and per-sentence character offsets are kept.
# This is the ceiling: a request may opt out of storage, never into it.
SAVE_ESSAYS = "YOUR_SAVE_ESSAYS"
# Analyses older than this are purged at startup. 0 disables purging.
ANALYSIS_RETENTION_DAYS = "YOUR_ANALYSIS_RETENTION_DAYS"

# --------------------------------------------------------------------- mongodb
MONGODB_URL = "YOUR_MONGODB_URL"
MONGODB_DATABASE = "YOUR_MONGODB_DATABASE"
MONGODB_ENABLED = "YOUR_MONGODB_ENABLED"
MONGODB_TIMEOUT_MS = "YOUR_MONGODB_TIMEOUT_MS"

# ----------------------------------------------------------------------- redis
# Optional. Caches deterministic analysis results under
# SHA256(essay + detector_version + model_version), which makes re-analysing a
# draft while editing effectively free. Nothing breaks without it.
REDIS_ENABLED = "YOUR_REDIS_ENABLED"
REDIS_URL = "YOUR_REDIS_URL"
REDIS_CACHE_TTL_SECONDS = "YOUR_REDIS_CACHE_TTL_SECONDS"

# ----------------------------------------------------------------------- kafka
# Optional. A 250-word essay analyses in ~0.3s and a 1200-word essay in ~1.7s,
# so the synchronous path is correct for normal use. Enable this only for
# genuinely long-running work (very large essays, batch jobs). When enabled,
# essays above ASYNC_THRESHOLD_CHARS are queued and the API returns 202.
KAFKA_ENABLED = "YOUR_KAFKA_ENABLED"
KAFKA_BOOTSTRAP_SERVERS = "YOUR_KAFKA_BOOTSTRAP_SERVERS"
KAFKA_ANALYSIS_TOPIC = "YOUR_KAFKA_ANALYSIS_TOPIC"
KAFKA_RESULT_TOPIC = "YOUR_KAFKA_RESULT_TOPIC"
KAFKA_CONSUMER_GROUP = "YOUR_KAFKA_CONSUMER_GROUP"
ASYNC_THRESHOLD_CHARS = "YOUR_ASYNC_THRESHOLD_CHARS"

# ------------------------------------------------------------ language model
# The causal LM used as a measuring instrument for token probabilities.
# It does NOT classify the essay. Larger models measure better and cost more:
#   distilgpt2  (82M)  ~0.3s per 250 words   - default
#   gpt2        (124M) ~0.5s per 250 words
#   gpt2-medium (355M) ~1.5s per 250 words
LM_MODEL_NAME = "YOUR_LM_MODEL_NAME"
LM_DEVICE = "YOUR_LM_DEVICE"
LM_MAX_WINDOW = "YOUR_LM_MAX_WINDOW"
LM_STRIDE = "YOUR_LM_STRIDE"
# true defers model loading until the first request (faster startup, slow first request)
LM_LAZY_LOAD = "YOUR_LM_LAZY_LOAD"
SPACY_MODEL = "YOUR_SPACY_MODEL"

# ------------------------------------------------------------------- artifacts
# Defaults to backend/ml/artifacts
# MODEL_PATH=
DETECTOR_VERSION = "YOUR_DETECTOR_VERSION"

# ------------------------------------------- dataset generation (offline only)
# Used ONLY by ml/generation/* to build training data. Never called during
# analysis. Without it, `ml.generation.bootstrap_corpus` builds an offline
# synthetic corpus instead.
GROQ_API_KEY = "YOUR_GROQ_API_KEY"
GROQ_BASE_URL = "YOUR_GROQ_BASE_URL"
GROQ_MODELS = "YOUR_GROQ_MODELS"
GROQ_REQUEST_TIMEOUT = "YOUR_GROQ_REQUEST_TIMEOUT"