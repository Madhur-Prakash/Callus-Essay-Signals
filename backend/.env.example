# Copy to `backend/.env` and edit. Never commit `.env`.
#
#   PowerShell:  cp .env.example .env
#   bash:        cp .env.example .env

# ----------------------------------------------------------------- application
APP_ENV=development
LOG_LEVEL=INFO
LOG_DIR=logs
# true emits JSON log lines instead of coloured console output (for aggregators)
LOG_JSON=false
# include per-stage timings in the analysis response
DEBUG_TIMINGS=true

# -------------------------------------------------------------------- security
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_ESSAY_CHARS=60000
MIN_ESSAY_CHARS=200
MAX_REQUEST_BYTES=1000000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --------------------------------------------------------------------- privacy
# When false, the essay body is NEVER written to storage. Only metadata,
# derived measurements and per-sentence character offsets are kept.
# This is the ceiling: a request may opt out of storage, never into it.
SAVE_ESSAYS=false
# Analyses older than this are purged at startup. 0 disables purging.
ANALYSIS_RETENTION_DAYS=30

# --------------------------------------------------------------------- mongodb
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=ai_essay_detector
MONGODB_ENABLED=true
MONGODB_TIMEOUT_MS=3000

# ----------------------------------------------------------------------- redis
# Optional. Caches deterministic analysis results under
# SHA256(essay + detector_version + model_version), which makes re-analysing a
# draft while editing effectively free. Nothing breaks without it.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=86400

# ----------------------------------------------------------------------- kafka
# Optional. A 250-word essay analyses in ~0.3s and a 1200-word essay in ~1.7s,
# so the synchronous path is correct for normal use. Enable this only for
# genuinely long-running work (very large essays, batch jobs). When enabled,
# essays above ASYNC_THRESHOLD_CHARS are queued and the API returns 202.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ANALYSIS_TOPIC=essay.analysis.requests
KAFKA_RESULT_TOPIC=essay.analysis.results
KAFKA_CONSUMER_GROUP=essay-analysis-workers
ASYNC_THRESHOLD_CHARS=25000

# ------------------------------------------------------------ language model
# The causal LM used as a measuring instrument for token probabilities.
# It does NOT classify the essay. Larger models measure better and cost more:
#   distilgpt2  (82M)  ~0.3s per 250 words   - default
#   gpt2        (124M) ~0.5s per 250 words
#   gpt2-medium (355M) ~1.5s per 250 words
LM_MODEL_NAME=distilgpt2
LM_DEVICE=cpu
LM_MAX_WINDOW=512
LM_STRIDE=384
# true defers model loading until the first request (faster startup, slow first request)
LM_LAZY_LOAD=false
SPACY_MODEL=en_core_web_sm

# ------------------------------------------------------------------- artifacts
# Defaults to backend/ml/artifacts
# MODEL_PATH=
DETECTOR_VERSION=1.0.0

# ------------------------------------------- dataset generation (offline only)
# Used ONLY by ml/generation/* to build training data. Never called during
# analysis. Without it, `ml.generation.bootstrap_corpus` builds an offline
# synthetic corpus instead.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,openai/gpt-oss-20b,gemma2-9b-it
GROQ_REQUEST_TIMEOUT=120
