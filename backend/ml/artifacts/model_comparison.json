      },
      "verdict": "no measurable difference (gap is inside fold-to-fold noise)"
    },
    {
      "question": "Are language-model probability features sufficient on their own?",
      "comparison": "lm_only vs baseline_stylometric",
      "macro_f1": {
        "lm_only": 0.7456,
        "baseline": 0.8214
      },
      "delta": -0.0758,
      "cv_std": {
        "lm_only": 0.034,
        "baseline": 0.0124
      },
      "verdict": "hurts"
    },
    {
      "question": "Does within-document style shift improve document classification?",
      "comparison": "hybrid vs hybrid_no_shift",
      "macro_f1": {
        "hybrid": 0.8438,
        "hybrid_no_shift": 0.8487
      },
      "delta": -0.005,
      "cv_std": {
        "hybrid": 0.0348,
        "hybrid_no_shift": 0.0239
      },
      "verdict": "no measurable difference (gap is inside fold-to-fold noise)",
      "note": "The style-shift block is retained in the shipped model even where it does not improve the document-level score, because the per-paragraph style-shift analysis is a user-facing output in its own right: it is what lets the UI point at the specific passage that differs from the rest of the essay. Dropping the features would remove that evidence to chase a difference this corpus cannot resolve."
    }
  ],
